<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Mor.PowerManagement.Application</RootNamespace>
    <AssemblyName>Mor.PowerManagement.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" />
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- EF Core 10 split the relational stack out of the base package. The
         telemetry series aggregates server-side via Database.SqlQuery<T>, which
         lives in Relational. Already in the solution's graph via the Npgsql
         provider and EFCore.Design, so this adds no new package download. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Transitive pin: Microsoft.Build.Tasks.Core/Utilities.Core 18.4.0 pull
         System.Security.Cryptography.Xml 10.0.1, which is inside the affected ranges
         of 8 High advisories (see Directory.Packages.props). The only Microsoft.Build.*
         version that raises the floor to a patched 10.0.10 targets net11.0 only, so the
         transitive pin is the fix that works on net10.0. No code in this project
         references System.Security.Cryptography.Xml directly. -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

</Project>
